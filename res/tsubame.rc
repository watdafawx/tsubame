#include <winver.h>

1 24 "tsubame.manifest"

// lowest icon ID = the exe's icon (Explorer, taskbar, Alt-Tab, shortcuts);
// generated by tools/make-icon.ps1 from res/tsubame.svg and res/tsubame-small.svg
1 ICON "tsubame.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,0,1,0
PRODUCTVERSION  0,0,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Tsubame"
            VALUE "FileDescription",  "Tsubame File Browser"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "tsubame"
            VALUE "LegalCopyright",   "Personal build"
            VALUE "OriginalFilename", "tsubame.exe"
            VALUE "ProductName",      "Tsubame"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
